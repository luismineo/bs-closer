{
  "manifest_version": 3,
  "name": "BS Closer",
  "version": "1.2.0",
  "description": "Automatically rejects cookies and dismisses consent banners, newsletter popups, marketing overlays and other annoyances.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/autoconsent/eval-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/autoconsent/autoconsent.js", "vendor/autoconsent/rules.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
